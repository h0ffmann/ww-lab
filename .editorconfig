root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 88

[*.{f90,F90,cuf}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.nml]
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
